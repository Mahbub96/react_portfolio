# Template for the server's runtime settings:
#   /var/www/html/<domain>/.env.runtime      (chmod 600, never in git)
#
# The deploy reads this file before starting the app and refuses to deploy
# when a required key is missing. Deploys never overwrite it.
# Full descriptions of every setting: env.example.
#
# For test.mahbub.dev use the same keys with:
#   SITE_ENV=test
#   a different JWT_SECRET
#   BLOG_UPLOAD_DIR=/var/www/html/test.mahbub.dev/uploads/blog
#   AI_RATE_PER_MIN lower than production (they share one provider limit)

# --- Required ---------------------------------------------------------------
JWT_SECRET=
ADMIN_PASSWORD_HASH=
MONGODB_URI=
SITE_ENV=production

# --- Admin sign-in -------------------------------------------------------------
ADMIN_USERNAME=mahbub

# --- Blog ---------------------------------------------------------------------------
BLOG_UPLOAD_DIR=/var/www/html/mahbub.dev/uploads/blog

# --- Contact form email -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- AI writing assist (optional) -------------------------------------------------------
NVIDIA_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_RATE_PER_MIN=25
AI_DAILY_LIMIT=300
AI_RULES_FILE=/var/www/html/mahbub.dev/ai-rules.txt

# --- Analytics (optional) -----------------------------------------------------------------
IPGEOLOCATION_API_KEY=
