# Environment settings for mahbub.dev — the complete list the code reads.
#
# Where each setting goes:
#   Local development  -> .env.local in the repo (git-ignored)
#   Test / production  -> $SERVER_DIR/.env.runtime on the server (chmod 600,
#                         never in git; see env.prod.example for a template)
#   Build time         -> the shell or .env.local on the machine that builds
#
# Restart the app after changing anything; settings are read at startup.
# .env.runtime is read by bash, so avoid "$" and backticks in its values
# (pnpm admin:hash already prints a "$"-free password hash).

# =============================================================================
# REQUIRED ON EVERY SERVER (the deploy refuses to start without them)
# =============================================================================
# Generate both with:  pnpm admin:hash   (use a different JWT_SECRET per server)
JWT_SECRET=
ADMIN_PASSWORD_HASH=
# MongoDB connection string for this environment.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# production on mahbub.dev, test on test.mahbub.dev; leave unset locally (= dev).
SITE_ENV=

# =============================================================================
# ADMIN SIGN-IN (optional)
# =============================================================================
ADMIN_USERNAME=mahbub
JWT_EXPIRES_IN=24h

# =============================================================================
# BLOG (optional)
# =============================================================================
# Keeps test/dev posts apart from production on a shared database.
# Default: none in production, "<SITE_ENV>_" elsewhere ("test_", "dev_").
BLOG_COLLECTION_PREFIX=
# Where uploaded images are stored. Default: $SERVER_DIR/uploads/blog in
# production builds, .uploads/blog in development. Use one folder per server.
BLOG_UPLOAD_DIR=
# Longest time published posts are cached between publishes (seconds).
BLOG_CACHE_SECONDS=300

# =============================================================================
# AI WRITING ASSIST (optional; the buttons stay hidden without NVIDIA_API_KEY)
# =============================================================================
# Calls happen only when the owner clicks a ✨ button. Drafts are sent to the
# provider when a suggestion is requested.
NVIDIA_API_KEY=
# Any model in the NVIDIA catalog; NIM_BASE_URL can be any OpenAI-compatible API.
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Keep the total across test + prod + local below the provider's limit (40/min).
AI_RATE_PER_MIN=30
# 0 = no daily cap
AI_DAILY_LIMIT=300
# Per short answer; body help gets twice this.
AI_MAX_TOKENS=600
AI_TIMEOUT_MS=25000
# Set 0 if a model rejects the reasoning switch.
AI_DISABLE_THINKING=1
# Plain text file with the rules every suggestion follows (max 4 KB).
# Start from ai-rules.example.txt. Unset = built-in rules.
AI_RULES_FILE=

# =============================================================================
# CONTACT FORM EMAIL (optional; the form cannot send without these)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# =============================================================================
# OTHER RUNTIME OPTIONS (optional)
# =============================================================================
# Visitor country/city lookup for analytics (ipgeolocation.io).
IPGEOLOCATION_API_KEY=
# Resume download: "dynamic" builds the PDF from portfolio data, "static"
# serves RESUME_STATIC_FILE.
RESUME_MODE=dynamic
RESUME_STATIC_FILE=/resume/Mahbub_Alam_Resume.pdf

# =============================================================================
# BUILD TIME (optional; baked into the build)
# =============================================================================
# Search engine ownership tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Override the footer version/build (normally from package.json and git).
APP_VERSION=
BUILD_NUMBER=

# =============================================================================
# DEPLOY SCRIPT (shell variables for pnpm deploy:*, not .env files)
# =============================================================================
# SERVER_HOST, SERVER_USER, SSH_KEY, SERVER_DIR, APP_NAME, APP_PORT,
# PUBLIC_BASE_URL, UPDATE_CONTENT=1 (sync db.json into MongoDB).
# Defaults are in scripts/deploy-local.sh.
