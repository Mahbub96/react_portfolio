# Environment Configuration for Mahbub Alam Portfolio
# Copy this file to .env.local and update with your actual values

# =============================================================================
# PRODUCTION DOMAIN CONFIGURATION
# =============================================================================
# Primary domain for production (mahbub.dev)
NEXT_PUBLIC_BASE_URL=https://mahbub.dev
NEXT_PUBLIC_SITE_URL=https://mahbub.dev
NEXT_PUBLIC_CANONICAL_URL=https://mahbub.dev

# =============================================================================
# SERVER RUNTIME SECRETS ($SERVER_DIR/.env.runtime)
# =============================================================================
# Secrets never go in git or in the build artifact. On each server they live
# in /var/www/html/<domain>/.env.runtime (chmod 600), which deploys never
# touch. scripts/deploy-local.sh refuses to deploy if a required key is
# missing, then exports the file before starting PM2.
#
# The file is sourced by bash. `pnpm admin:hash` prints ready-to-paste
# lines; the password hash is base64-encoded ("b64:...") so it contains no
# "$" for bash or Next's .env loader to expand. Use different values on test
# and production.
#
#   JWT_SECRET='<48+ random bytes, base64url>'      # required, 32+ chars
#   ADMIN_USERNAME=mahbub                            # optional, default mahbub
#   ADMIN_PASSWORD_HASH=b64:...                      # required; no default
#   MONGODB_URI='mongodb://...'                      # required
#   SITE_ENV=production                              # required: production | test
#   EMAIL_USER=... / EMAIL_PASS=...                  # contact form SMTP
#
# For local development put the same keys in .env.local. Without
# ADMIN_PASSWORD_HASH, admin login is disabled; without JWT_SECRET, dev uses
# a random per-process secret.

# =============================================================================
# AI WRITING ASSIST (optional, server only)
# =============================================================================
# Suggestions in the blog editor run only when the owner clicks a ✨ button.
# Without NVIDIA_API_KEY the buttons are hidden. Put these in .env.runtime on
# the server (and .env.local for development); restart to apply changes.
# Drafts are sent to the provider when a suggestion is requested.
#
#   NVIDIA_API_KEY=nvapi-...
#   NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # any model in the catalog
#   NIM_BASE_URL=https://integrate.api.nvidia.com/v1  # any OpenAI-compatible API
#   AI_RATE_PER_MIN=30     # keep the total across test + prod below the provider's limit
#   AI_DAILY_LIMIT=300     # 0 = no daily cap
#   AI_MAX_TOKENS=600      # per short answer; body help gets twice this
#   AI_TIMEOUT_MS=25000
#   AI_DISABLE_THINKING=1  # set 0 if a model rejects the reasoning switch
#   AI_RULES_FILE=/var/www/html/<domain>/ai-rules.txt
#
# AI_RULES_FILE is a plain text file with the rules every suggestion must
# follow (see ai-rules.example.txt). It is a file, not an env value, because
# .env.runtime is read by bash. Max 4 KB.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string
# For production: Use MongoDB Atlas or your production MongoDB instance
# For local development: Use localhost:27017
MONGODB_URI=mongodb://localhost:27017/portfolio

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP server settings for contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Alternative email services:
# Gmail: smtp.gmail.com:587
# Outlook: smtp-mail.outlook.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================
# Next.js authentication secret (generate a strong random string)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=https://mahbub.dev

# For local development only:
# NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================
# Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Search engine verification
# Leave blank locally. Set real values in production hosting settings.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# =============================================================================
# SOCIAL MEDIA & EXTERNAL LINKS
# =============================================================================
# Social media profiles
GITHUB_URL=https://github.com/mahbub96
LINKEDIN_URL=https://linkedin.com/in/md-mahbub-alam-6b751821b
FACEBOOK_URL=https://fb.me/MahbubCSE96
TWITTER_URL=https://twitter.com/mahbubcse96

# Company website
BROTECS_URL=https://brotecs.com

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================
# Rate limiting for contact form
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX_REQUESTS=3

# CORS settings
CORS_ORIGIN=https://mahbub.dev

# For local development only:
# CORS_ORIGIN=http://localhost:3000

# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment these lines for local development only:
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CANONICAL_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# =============================================================================
# ENVIRONMENT DETECTION
# =============================================================================
# Set to 'production' for production builds
NODE_ENV=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_VISITOR_TRACKING=true
ENABLE_CONTACT_FORM=true
ENABLE_PWA=true
ENABLE_SEO=true

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Build output directory
OUTPUT_DIR=.next

# Static export (optional)
STATIC_EXPORT=false

# =============================================================================
# NOTES FOR LOCAL DEVELOPMENT
# =============================================================================
# 1. Copy this file to .env.local
# 2. Update MONGODB_URI for your local MongoDB instance
# 3. Set up SMTP credentials for email testing
# 4. For local development, URLs will automatically use localhost:3000
# 5. Production domain (mahbub.dev) is used for all SEO and PWA features
# 6. Local development overrides are provided above for testing

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production:
# 1. Set NODE_ENV=production
# 2. Update MONGODB_URI to production database
# 3. Configure production SMTP settings
# 4. Set production NEXTAUTH_URL
# 5. Verify all URLs point to mahbub.dev
# 6. Test contact form functionality
# 7. Verify PWA installation
# 8. Check SEO meta tags and structured data
